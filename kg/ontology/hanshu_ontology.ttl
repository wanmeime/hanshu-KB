@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix hs: <http://hanshu-kb.org/ontology#> .

# 汉书知识库本体 (Hanshu KB Ontology)
# 从120卷标注实例 Bottom-Up 归纳生成

# === 本体元数据 ===
hs:HanshuOntology a owl:Ontology ;
    rdfs:label "汉书知识库本体" ;
    rdfs:comment "从《汉书》120卷实体标注归纳生成的本体，复用史记KB方法论" .

# === 实体类型定义 ===
hs:Entity a owl:Class ;
    rdfs:label "Entity" .

hs:Person a owl:Class ;
    rdfs:label "人名" ;
    rdfs:subClassOf hs:Entity .

hs:Place a owl:Class ;
    rdfs:label "地名" ;
    rdfs:subClassOf hs:Entity .

hs:Time a owl:Class ;
    rdfs:label "时间" ;
    rdfs:subClassOf hs:Entity .

hs:Organization a owl:Class ;
    rdfs:label "Organization" ;
    rdfs:subClassOf hs:Entity .

hs:OfficialTitle a owl:Class ;
    rdfs:label "官职" ;
    rdfs:subClassOf hs:Organization .

hs:State a owl:Class ;
    rdfs:label "邦国" ;
    rdfs:subClassOf hs:Organization .

hs:Dynasty a owl:Class ;
    rdfs:label "朝代" ;
    rdfs:subClassOf hs:Organization .

hs:EthnicGroup a owl:Class ;
    rdfs:label "族群" ;
    rdfs:subClassOf hs:Organization .

hs:Status a owl:Class ;
    rdfs:label "身份" ;
    rdfs:subClassOf hs:Entity .

hs:System a owl:Class ;
    rdfs:label "制度" ;
    rdfs:subClassOf hs:Entity .

hs:Artifact a owl:Class ;
    rdfs:label "器物" ;
    rdfs:subClassOf hs:Entity .

hs:Astronomy a owl:Class ;
    rdfs:label "天文" ;
    rdfs:subClassOf hs:Entity .

hs:Mythology a owl:Class ;
    rdfs:label "神话" ;
    rdfs:subClassOf hs:Entity .

hs:Biology a owl:Class ;
    rdfs:label "生物" ;
    rdfs:subClassOf hs:Entity .

hs:Book a owl:Class ;
    rdfs:label "典籍" ;
    rdfs:subClassOf hs:Entity .

hs:Ritual a owl:Class ;
    rdfs:label "礼仪" ;
    rdfs:subClassOf hs:Entity .

hs:Law a owl:Class ;
    rdfs:label "刑法" ;
    rdfs:subClassOf hs:Entity .

hs:Thought a owl:Class ;
    rdfs:label "思想" ;
    rdfs:subClassOf hs:Entity .

hs:Quantity a owl:Class ;
    rdfs:label "数量" ;
    rdfs:subClassOf hs:Entity .

# === 对象属性 ===
hs:hasName a owl:ObjectProperty ;
    rdfs:label "名称" ;
    rdfs:domain hs:Entity ;
    rdfs:range xsd:string .

hs:hasCanonicalName a owl:ObjectProperty ;
    rdfs:label "规范名" ;
    rdfs:domain hs:Entity ;
    rdfs:range xsd:string .

hs:hasTime a owl:ObjectProperty ;
    rdfs:label "时间" ;
    rdfs:domain hs:Entity ;
    rdfs:range hs:Time .

hs:hasPlace a owl:ObjectProperty ;
    rdfs:label "地点" ;
    rdfs:domain hs:Entity ;
    rdfs:range hs:Place .

hs:hasDynasty a owl:ObjectProperty ;
    rdfs:label "朝代" ;
    rdfs:domain hs:Entity ;
    rdfs:range hs:Dynasty .

hs:bornIn a owl:ObjectProperty ;
    rdfs:label "出生于" ;
    rdfs:domain hs:Person ;
    rdfs:range hs:Time .

hs:diedIn a owl:ObjectProperty ;
    rdfs:label "卒于" ;
    rdfs:domain hs:Person ;
    rdfs:range hs:Time .

hs:bornAt a owl:ObjectProperty ;
    rdfs:label "出生地" ;
    rdfs:domain hs:Person ;
    rdfs:range hs:Place .

hs:hasTitle a owl:ObjectProperty ;
    rdfs:label "官职" ;
    rdfs:domain hs:Person ;
    rdfs:range hs:OfficialTitle .

hs:fatherOf a owl:ObjectProperty ;
    rdfs:label "父" ;
    rdfs:domain hs:Person ;
    rdfs:range hs:Person .

hs:motherOf a owl:ObjectProperty ;
    rdfs:label "母" ;
    rdfs:domain hs:Person ;
    rdfs:range hs:Person .

hs:spouseOf a owl:ObjectProperty ;
    rdfs:label "配偶" ;
    rdfs:domain hs:Person ;
    rdfs:range hs:Person .

hs:brotherOf a owl:ObjectProperty ;
    rdfs:label "兄弟" ;
    rdfs:domain hs:Person ;
    rdfs:range hs:Person .

hs:serves a owl:ObjectProperty ;
    rdfs:label "臣事" ;
    rdfs:domain hs:Person ;
    rdfs:range hs:Person .

hs:enemyOf a owl:ObjectProperty ;
    rdfs:label "敌对" ;
    rdfs:domain hs:Person ;
    rdfs:range hs:Person .

hs:alliedWith a owl:ObjectProperty ;
    rdfs:label "联盟" ;
    rdfs:domain hs:Person ;
    rdfs:range hs:Person .

hs:teacherOf a owl:ObjectProperty ;
    rdfs:label "师" ;
    rdfs:domain hs:Person ;
    rdfs:range hs:Person .

hs:appointedBy a owl:ObjectProperty ;
    rdfs:label "封赏" ;
    rdfs:domain hs:Person ;
    rdfs:range hs:Person .

