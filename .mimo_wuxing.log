}
SRC = {
    '001': 'kg/entities/试点/卷001_标注.txt',
    '034': 'kg/entities/试点/卷034_标注.txt',
}
DST = {
    '001': 'kg/entities/试点/重标_卷001_标注.txt',
    '034': 'kg/entities/试点/重标_卷034_标注.txt',
}

# ---------- 卷001 ----------
