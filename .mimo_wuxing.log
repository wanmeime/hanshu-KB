    ('〖@陈王〗', '〖@陈王|陈涉〗'),
    ('〖@亚父〗', '〖@亚父|范增〗'),
]:
    E1.append(('re', old, new))

# C. "信"一字三指，逐处消歧（丁2）：前4处=韩信，第5处=纪信（"羽烧杀信"）
