# A. 单字人名省称强制消歧（v2 规则15）
D1 = {'羽':'项羽','豹':'魏豹','布':'黥布','歇':'赵歇','萧':'萧何','曹':'曹参',
      '欣':'司马欣','荣':'田荣','越':'彭越','角':'萧公角','齮':'南阳守齮',
      '良':'张良','翳':'董翳','籍':'项羽','季':'刘邦','市':'田市','广':'田广',
      '建':'田建','平':'泗川监平','壮':'泗川守壮','咎':'曹咎','卬':'司马卬',
      '伯':'项伯','得':'左司马得','齿':'雍齿','鳃':'高武侯鳃'}
for c, n in D1.items():
    E1.append(('re', f'〖@{c}〗', f'〖@{c}|{n}〗'))

# B. 多字省称/多形名消歧（v2 规则15/16）
for old, new in [
    ('〖@食其〗', '〖@食其|郦食其〗'),
