E1.append(('occur', '〖@信〗', ['〖@信|韩信〗']*4 + ['〖@信|纪信〗']))

#!/usr/bin/env python3
"""分批装配标注稿 + 逐段完整性预校验。

用法:
    python3 scripts/assemble_annotation.py <底本> <输出> <chunk1> [chunk2 ...]

chunk 文件每行格式:  段落行号<TAB>标注后段落文本
