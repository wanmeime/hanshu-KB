TYPE=set('@=;&#%^~•!?+◆{:[_$◈◉○◇')
def striplen_from(ann, pos):
    # compute stripped length of ann[:pos] with partial handling
    out=[];i=0
    while i<pos:
        ch=ann[i]
        if ch in '〖⟦〘':
            close={'〖':'〗','⟦':'⟧','〘':'〙'}[ch]
            j=ann.find(close,i)
            if j==-1 or j>=pos:
                out.append(ann[i:pos]);i=pos;continue
            inner=ann[i+1:j]
            if inner and inner[0] in TYPE: inner=inner[1:]
            if ch=='〘': out.append(inner)
            else: out.append(inner.split('|',1)[0])
            i=j+1
        else:
            out.append(ch);i+=1
    return ''.join(out)
