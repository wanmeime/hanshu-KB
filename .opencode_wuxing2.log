import sys, re
def repair(s):
    pairs={'\u3016':'\u3017','\u27e6':'\u27e7','\u3010':'\u3011'}
    close={'\u3017','\u27e7'}
    out=[]; stack=[]
    i=0
    while i<len(s):
        ch=s[i]
        if ch in pairs:
            stack.append(pairs[ch]); out.append(ch)
        elif ch in close:
            if stack:
                exp=stack.pop()
                out.append(exp)
            else:
                out.append(ch)
        else:
            out.append(ch)
        i+=1
    return ''.join(out), stack
if __name__=='__main__':
    p=sys.argv[1]
    s=open(p,encoding='utf-8').read()
    r,left=repair(s)
    if left: print('UNCLOSED:', left)
    # if unclosed, append missing closers
    if left:
        r=r+''.join(left)
    open(p,'w',encoding='utf-8').write(r)
    print('repaired; counts', r.count('\u3016'), r.count('\u3017'), r.count('\u27e6'), r.count('\u27e7'))
