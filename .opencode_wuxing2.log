import importlib.util, difflib
spec=importlib.util.spec_from_file_location('v','scripts/verify_annotation.py')
m=importlib.util.module_from_spec(spec); spec.loader.exec_module(m)
base=open('data/chapter_numbered/卷027_五行志第七上.txt',encoding='utf-8').read().split('\n')
ann=open('kg/entities/标注/卷027_标注.txt',encoding='utf-8').read().split('\n')
bad=[i+1 for i in range(min(len(base),len(ann))) if m.strip_marks(ann[i])!=base[i]]
print('lines',len(base),len(ann),'bad',bad)
for n in bad:
    s=m.strip_marks(ann[n-1]); sm=difflib.SequenceMatcher(None,base[n-1],s)
    for tag,i1,i2,j1,j2 in sm.get_opcodes():
        if tag!='equal': print(n,tag,repr(base[n-1][max(0,i1-25):i2+25]),'->',repr(s[max(0,j1-25):j2+25]))
