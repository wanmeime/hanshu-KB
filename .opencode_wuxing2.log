import re
p='kg/entities/标注/卷027_标注.txt'
s=open(p,encoding='utf-8').read()
#灾/燔 -> 刑罚动词
s=re.sub('\u27e6\u25c8(\u7075\u7900|\u77ff|\u7075|\u95d0|\u81e3\u4e0b)\u27e7', lambda m:'\u27e6\u25c9'+m.group(1)+'\u27e7', s)
# remove verb brackets on pure nouns
for t in ('\u77f3','\u77f3\u9f13','\u90fe','\u81e3\u4e0b'):
    s=s.replace('\u27e6\u25c8'+t+'\u27e7', t)
# disambiguate single-char ancient sage names
for a,b in (('\u3016@\u7a37\u3011','\u3016@\u7a37|\u590f\u7a37\u3011'),
            ('\u3016@\u9ca9\u3011','\u3016@\u9ca9|\u9c9c\u9ca9\u3011'),
            ('\u3016@\u5c27\u3011','\u3016@\u5c27|\u5510\u5c27\u3011'),
            ('\u3016@\u8215\u3011','\u3016@\u8215|\u865e\u8215\u3011'),
            ('\u3016@\u5951\u3011','\u3016@\u5951|\u5546\u5951\u3011')):
    s=s.replace(a,b)
open(p,'w',encoding='utf-8').write(s)
print('ok')
