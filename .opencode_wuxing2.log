lines=open(p,encoding='utf-8').read().split('\n')
def fixq(line):
    out=[]; d=True; s_=True
    for ch in line:
        if ch=='"':
            out.append('\u201c' if d else '\u201d'); d=not d
        elif ch=="'":
            out.append('\u2018' if s_ else '\u2019'); s_=not s_
        else: out.append(ch)
    return ''.join(out)
lines=[fixq(l) for l in lines]
s='\n'.join(lines)
s=s.replace('\u3016;\u5185\u53f2\u3011\u3016@\u8fc7|\u5185\u53f2\u8fc7\u3011\u5f52\u544a', '\u3016@\u8fc7|\u5185\u53f2\u8fc7\u3011\u5f52\u544a')
s=s.replace('\u3016@\u7a46\u53d4\u3011\u66f0', '\u3016@\u7a46\u5b50\u3011\u66f0')
s=s.replace('\u662f\u70ba\u662d\u516c', '\u662f\u4e3a\u662d\u516c')
open(p,'w',encoding='utf-8').write(s)
print('ok')
